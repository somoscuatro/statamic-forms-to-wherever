{
    "name": "somoscuatro/forms-to-wherever",
    "type": "statamic-addon",
    "description": "Base forms connector system for Statamic",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Stokoe",
            "email": "michael@stokoe.me"
        },
        {
            "name": "somoscuatro",
            "homepage": "https://somoscuatro.com",
            "email": "tech@somoscuatro.es"
        }
    ],
    "autoload": {
        "psr-4": {
            "Somoscuatro\\FormsToWherever\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Somoscuatro\\FormsToWherever\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Forms To Wherever",
            "description": "Base forms connector system for Statamic"
        },
        "laravel": {
            "providers": [
                "Somoscuatro\\FormsToWherever\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/somoscuatro/statamic-forms-to-wherever/issues",
        "source": "https://github.com/somoscuatro/statamic-forms-to-wherever"
    }
}
